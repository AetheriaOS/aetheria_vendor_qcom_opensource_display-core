soong_namespace {
    imports: ["vendor/xiaomi/peridot", "hardware/qcom-caf/sm8750", "vendor/qcom/opensource/commonsys-intf/display"],
}

cc_library_shared {
    name: "vendor.qti.hardware.display.snapalloc-impl",
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,
    owner: "qti",
    shared_libs: [
        "libbase",
        "libjsoncpp",
        "libdmabufheap",
        "libvmmem",
        "libsync",
    ],
    header_libs: [
        "display_intf_headers",
        "snapalloc_interface_headers",
        "common_interface_headers",
    ],
    defaults: ["qtidisplay_defaults_headless"],
    cflags: [
        "-DLOG_TAG=\"SnapAlloc\"",
        "-Wno-unused-parameter",
        "-Wall",
        "-Werror",
    ],
    srcs: ["*.cpp"],
}
